# Copy this file to ".env" in the same folder and fill it in.
# Find these in hPanel > Databases > Management (the same database the CRM uses).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_yourdb
DB_USER=u123456789_youruser
DB_PASS=your-database-password
# Optional: connect through a socket file instead of DB_HOST/DB_PORT.
# DB_SOCKET=/path/to/mysqld.sock
# Optional: must match the CRM's app.timezone (bam_config.php). Default: America/New_York.
# APP_TIMEZONE=America/New_York
